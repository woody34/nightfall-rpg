# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://nightfall:nightfall@localhost:5432/nightfall
NATS_URL=nats://localhost:4222
HTTP_ADDR=0.0.0.0:3000
GRPC_ADDR=0.0.0.0:50051
RUST_LOG=info,tower_http=debug,sqlx=warn
# Telemetry: unset OTEL_EXPORTER_OTLP_ENDPOINT to disable export (logs still go to stdout).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=nightfall-api
# 1 = human-readable stdout logs instead of JSON.
TELEMETRY_PRETTY=1
# Keycloak (docker compose). Server validates JWTs against these.
# Unset OIDC_ISSUER and every RPC except Ping is refused (fail closed).
OIDC_ISSUER=http://localhost:8080/realms/nightfall
OIDC_AUDIENCE=nightfall-api
# 1 = accept unsigned `test:<account_uuid>` bearer tokens instead of Keycloak JWTs. Dev only.
# AUTH_DEV_TOKENS=1
# Public WebSocket URL returned with each play ticket (default ws://localhost:3000/ws).
WS_PUBLIC_URL=ws://localhost:3000/ws
# Tests: set to run the real-Keycloak integration test (tests/keycloak_device_flow.rs), e.g.
#   KEYCLOAK_URL=http://localhost:8080 moon run api:test
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
