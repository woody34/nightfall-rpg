# covers: 1 E2.5, 1 E3.2, 1a E3.7
# Requires AUTH_DEV_TOKENS=1 ZONE_SIM_FIXTURE=phase1a-social-aggro, zone/replay id 1.
# Only A and B enter this fresh stack. B sees all three NPC AttackResults and no attacks on B;
# with exactly one other player in view, their target is A. A also asserts attacked_by == 3.
# This follows actual clan_call: helpers inherit hate for the caller's target, not bystander B.
# B stands within ordinary aggro range, closer to both helpers than A. Passive rooted NPCs
# cannot satisfy this by proximity or wandering. B moves to (104,103) only after verifying it.
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor players_in_view == 1 30
nf.ClickMove 40 40
nf.WaitFor own_at 40 40 0.25 35
nf.ClickMove 80 85
nf.WaitFor own_at 80 85 0.25 36
nf.Expect npcs_fighting == 0
nf.Expect attacked_by == 0
nf.ClickMove 104 102
nf.WaitFor own_at 104 102 0.25 18
nf.WaitFor proxy_at 99 100 0.25 30
nf.Expect players_in_view == 1
nf.WaitFor npcs_fighting == 3 30
nf.Expect attacked_by == 0
nf.ClickMove 104 103
nf.WaitFor own_at 104 103 0.25 3
nf.WaitFor players_in_view == 0 20 # A exits only after seeing B's completion signal
nf.Expect attacked_by == 0
nf.Within 150
