# covers: 3 E3.1, 3 E3.5, 3 E4.2, 3 E4.3, 3 E4.6, 3 E5.3, 3 E5.6, 3 E6.7
# fixture: phase3-pvp
# Pending engine/client integration; declaration is not execution evidence.
# Timeouts: received-state delivery 10 ticks *100ms *3 =3s (A1).
# Login/RPC: existing runner allowance5s *3=15s; movement<=37.5tiles /3.75tiles/s *3<=30s.
# Speed input: professions/human_mystic.toml:22 (run120); domain/zone/phase2.rs:109-112 (375milli-tiles/tick).
# Fixture combat30s *3=90s; no damage calculation determines a wait.
# Pinned dp3ca488dd src/main/resources/data/stats/skills/01100-01199.xml:1645,1846:
# Wind Strike base hitTime4000ms *3=12s; Ice Bolt base3100ms *3 rounds up to12s.
# 01000-01099.xml:554,1553,1560: Resurrection6000ms *3=18s, Might1200s *3=3600s.
# A6: regen30ticks *100ms *3=9s; A16/R7: flag1200ticks *100ms *3=360s.
# Boundaries are checked against received ticks/deadlines; source waits are conservative budgets.
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor own_sp >= 0 3
nf.WaitFor entity_in_view 01970000-0000-7000-8000-000000000031 30
nf.Expect own_flag == none
nf.Target 01970000-0000-7000-8000-000000000031
nf.Attack
nf.WaitFor own_flag == pvp 3
nf.WaitFor player_cp_damage_total > 0 12
nf.StopAttack
nf.Expect victim_flag_not_refreshed
nf.Expect own_flag_deadline_matches_received
nf.WaitFor own_flag == none 360
nf.Expect own_pk == 0
nf.Expect own_pvp == 0
# Boundary setup: A110,116 is outside; B117,116 is inside the inclusive peace square.
nf.ClickMove 110 116
nf.WaitFor own_at 110 116 1 30
nf.WaitFor entity_at 01970000-0000-7000-8000-000000000031 117 116 0.5 30
nf.Attack
nf.WaitFor rejected == peace_zone 3
nf.Expect peace_rejection_has_no_start
# Received Might application is the peer's signal to leave peace for an accepted cast.
nf.Cast 1068 self
nf.WaitFor buff_active 1068 12
nf.WaitFor entity_at 01970000-0000-7000-8000-000000000031 115 116 0.5 30
nf.Cast 1177
nf.WaitFor cast_state == casting 12
# Peer crosses only two tiles after observing Started. Assert the server cancellation
# and the target's received HP history; no local HP prediction or timer simulation.
nf.WaitFor cast_cancel_reason == peace_zone 12
nf.Expect peace_impact_has_no_damage
nf.Expect cast_dispositions_once
nf.WaitFor entity_at 01970000-0000-7000-8000-000000000031 115 116 0.5 30
nf.WaitFor target_flag == pvp 30
nf.Attack
nf.WaitFor own_pvp == 1 90
nf.StopAttack
nf.Expect own_pk == 0
nf.Expect own_karma == 0
nf.Expect flagged_kill_matches_received
nf.WaitFor entity_alive 01970000-0000-7000-8000-000000000031 30
nf.Target 01970000-0000-7000-8000-000000000031
nf.WaitFor target_flag == none 180
nf.WaitFor target_flag == pvp 30
# Test scheduling window10 ticks is a fixture choice, not a cast formula.
# The predicate checks received flag deadline minus received current tick; the final
# assertion MUST witness Started before expiry and impact at/after it (no vacuous pass).
nf.WaitFor target_flag_remaining <= 10 360
nf.WaitFor skill_ready 1177 12
nf.Cast 1177
nf.WaitFor target_flag_expired_at_last_impact 12
nf.Expect impact_counter_uses_received_flag
nf.Expect entity_alive 01970000-0000-7000-8000-000000000031
# Finish the same neutral victim through ordinary combat, then verify the PK branch.
nf.Attack
nf.WaitFor own_pk == 1 90
nf.StopAttack
nf.Expect own_pvp == 1
nf.Expect own_karma > 0
nf.Expect karma_gain_matches_oracle
nf.Expect pvp_private_stats_coherent
# Total budget >= sum of the derived per-step timeouts plus30s exit grace.
nf.Within 1500
