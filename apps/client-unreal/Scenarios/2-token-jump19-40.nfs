# covers: 2 E4.1, 2 E4.2, 2 E4.3, 2 E4.4, 2 E5.5
# fixture: phase2-token-jump19-40
# Pinned oracle: Human 19 (835861 XP) -> single oracle kill (14587068 XP) -> jumps to 40 (15422929 XP).
# Both tier1 and tier2 milestone tokens granted (1/1). Durable claim survives reconnect.
# Transfers 0->1->2 consume both balances, granted skills 0. Reconnect and historical retry prevent duplicate refill.
nf.Login
nf.WaitFor connected 15
nf.ClassCatalogue
nf.WaitFor class_rpc_error == none 15
nf.Expect catalogue_learning_metadata
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor initial_tier1_tokens == 0 5
nf.WaitFor initial_tier2_tokens == 0 5
nf.Expect initial_tier1_tokens == 0
nf.Expect initial_tier2_tokens == 0
# Initial baseline: level 19, tokens 0/0
nf.WaitFor own_level == 19 3
nf.WaitFor own_xp == 835861 3
nf.WaitFor own_tier1_tokens == 0 3
nf.WaitFor own_tier2_tokens == 0 3
nf.Expect world_class == 0
nf.Expect at_class_master
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 0
nf.Expect options_tier2_tokens == 0
nf.Expect transfer_option 1 blocked
# Single massive oracle kill: direct multi-level milestone jump from 19 to 40
nf.WaitFor template_target_available token_oracle 15
nf.Target template:token_oracle
nf.Attack
nf.WaitFor own_level == 40 5
nf.WaitFor own_xp == 15422929 5
# Both token tiers granted
nf.WaitFor own_tier1_tokens == 1 5
nf.WaitFor own_tier2_tokens == 1 5
nf.StopAttack
nf.ClickMove 126 126
nf.WaitFor own_at 126 126 0.5 15
nf.Expect at_class_master
nf.Sleep 2
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 1
nf.Expect options_tier2_tokens == 1
nf.Expect transfer_option 1 eligible
# Reconnect before consumption proves durable jump state
nf.DropSocket
nf.WaitFor reconnects >= 1 15
nf.WaitFor own_spawns >= 2 15
nf.WaitFor in_world 15
nf.WaitFor initial_tier1_tokens == 1 5
nf.WaitFor initial_tier2_tokens == 1 5
nf.Expect initial_tier1_tokens == 1
nf.Expect initial_tier2_tokens == 1
nf.WaitFor own_level == 40 5
nf.WaitFor own_xp == 15422929 5
nf.WaitFor own_tier1_tokens == 1 5
nf.WaitFor own_tier2_tokens == 1 5
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 1
nf.Expect options_tier2_tokens == 1
nf.Expect transfer_option 1 eligible
# Transfer 0 -> 1 consumes tier1 token
nf.ClickMove 126 126
nf.WaitFor own_at 126 126 0.5 5
nf.Expect at_class_master
nf.ChangeClass 1 01970000-0000-7000-8000-000000000031
nf.WaitFor class_rpc_error == none 15
nf.WaitFor world_class == 1 3
nf.Expect transfer_granted_skill_keys == 0
nf.Expect transfer_count == 1
nf.WaitFor own_tier1_tokens == 0 5
nf.WaitFor own_tier2_tokens == 1 3
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 0
nf.Expect options_tier2_tokens == 1
nf.Expect transfer_option 2 eligible
# Transfer 1 -> 2 consumes tier2 token
nf.ChangeClass 2 01970000-0000-7000-8000-000000000032
nf.WaitFor class_rpc_error == none 15
nf.WaitFor world_class == 2 3
nf.Expect transfer_granted_skill_keys == 0
nf.Expect transfer_count == 2
nf.WaitFor own_tier1_tokens == 0 3
nf.WaitFor own_tier2_tokens == 0 5
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 0
nf.Expect options_tier2_tokens == 0
# Reconnect and explicit historical retry: verify no duplicate grant or refill
nf.Character
nf.WaitFor class_rpc_error == none 15
nf.Expect character_class == 2
nf.Expect character_matches_world
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.MarkClassState
nf.DropSocket
nf.WaitFor reconnects >= 2 15
nf.WaitFor own_spawns >= 3 15
nf.WaitFor in_world 15
nf.WaitFor initial_tier1_tokens == 0 5
nf.WaitFor initial_tier2_tokens == 0 5
nf.Expect initial_tier1_tokens == 0
nf.Expect initial_tier2_tokens == 0
nf.WaitFor own_level == 40 5
nf.WaitFor own_xp == 15422929 5
nf.Expect own_level == 40
nf.Expect own_xp == 15422929
nf.WaitFor world_class == 2 3
nf.Character
nf.WaitFor class_rpc_error == none 15
nf.Expect character_matches_world
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 0
nf.Expect options_tier2_tokens == 0
nf.MarkClassState
# Retry historical class 1 key: frozen receipt returned, live state stays 2
nf.ChangeClass 1 01970000-0000-7000-8000-000000000031
nf.WaitFor class_rpc_error == none 15
nf.Expect transfer_receipt_class == 1
nf.Expect world_class == 2
nf.Expect class_state_matches_mark
nf.Expect own_tier1_tokens == 0
nf.Expect own_tier2_tokens == 0
# Retry historical class 2 key: frozen receipt returned, live state stays 2
nf.ChangeClass 2 01970000-0000-7000-8000-000000000032
nf.WaitFor class_rpc_error == none 15
nf.Expect transfer_receipt_class == 2
nf.Expect world_class == 2
nf.Expect class_state_matches_mark
nf.Expect own_tier1_tokens == 0
nf.Expect own_tier2_tokens == 0
nf.Within 120
