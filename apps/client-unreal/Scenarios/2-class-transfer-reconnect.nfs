# covers: 2 E3.1, 2 E3.3, 2 E3.6, 2 E4.2, 2 E5.4, 2 E5.5
# fixture: phase2-transfer
# Source oracle: pinned class trees0/1/2 at40 share four auto_get keys; empty fixture catches up4 once, then delta0.
# Same independent pre-admission level40 Human0 tokens1/1 fixture as positive transfer.
# Transfer then reconnect between tiers, reconstruct from admission facts/RPC persistence.
nf.Login
nf.WaitFor connected 15
nf.ClassCatalogue
nf.WaitFor class_rpc_error == none 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.ChangeClass 1 01970000-0000-7000-8000-000000000101
nf.WaitFor class_rpc_error == none 15
nf.WaitFor world_class == 1 3
nf.Expect transfer_granted_skill_keys == 4
nf.Expect transfer_granted_keys l2.skill.1320 l2.skill.1322 l2.skill.194 l2.skill.239
nf.DropSocket
nf.WaitFor reconnects >= 1 15
nf.WaitFor own_spawns >= 2 15
nf.WaitFor world_class == 1 3
nf.Expect transfer_granted_skill_keys == 4
nf.Expect transfer_granted_keys l2.skill.1320 l2.skill.1322 l2.skill.194 l2.skill.239
nf.Character
nf.WaitFor class_rpc_error == none 15
nf.Expect character_class == 1
nf.Expect character_matches_world
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 0
nf.Expect transfer_option 2 eligible
nf.ChangeClass 2 01970000-0000-7000-8000-000000000102
nf.WaitFor class_rpc_error == none 15
nf.WaitFor world_class == 2 3
nf.Expect transfer_granted_skill_keys == 0
nf.DropSocket
nf.WaitFor reconnects >= 2 15
nf.WaitFor own_spawns >= 3 15
nf.WaitFor world_class == 2 3
nf.Expect transfer_granted_skill_keys == 0
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 0
nf.Expect options_tier2_tokens == 0
nf.Character
nf.WaitFor class_rpc_error == none 15
nf.Expect character_matches_world
nf.Expect own_class_events == 0
nf.Expect own_class_wire_events == 2
nf.WaitFor own_max_cp > 0 3
nf.MarkClassState
# Replay tier1 key after tier2/reconnect: frozen class1 receipt is correct, current state stays2.
nf.ChangeClass 1 01970000-0000-7000-8000-000000000101
nf.WaitFor class_rpc_error == none 15
nf.Expect transfer_receipt_class == 1
nf.Expect transfer_receipt_tier2_tokens == 1
nf.Expect transfer_granted_skill_keys == 4
nf.Expect transfer_granted_keys l2.skill.1320 l2.skill.1322 l2.skill.194 l2.skill.239
nf.Expect world_class == 2
nf.Expect character_class == 2
nf.Expect options_current_class == 2
nf.Expect options_tier1_tokens == 0
nf.Expect options_tier2_tokens == 0
nf.Expect own_class_events == 0
nf.Expect own_class_wire_events == 2
nf.Expect class_state_matches_mark
nf.Sleep 1
nf.Expect class_state_matches_mark
nf.Character
nf.WaitFor class_rpc_error == none 15
nf.Expect character_matches_world
nf.Within 120
