# covers: 2 E3.1, 2 E3.2, 2 E3.3, 2 E3.6, 2 E4.2, 2 E4.4, 2 E5.2, 2 E5.3, 2 E5.4, 2 E5.5
# fixture: phase2-transfer
# Source oracle: pinned class trees0/1/2 at40 share four auto_get keys; empty fixture catches up4 once, then delta0.
# Requires isolated DB fixture BEFORE admission: Human base0, level40, XP threshold40, female,
# position126,126, tier1/tier2 token counts1. No live state edit/GM bypass is used.
# Token grants/fixture creation are controlled by the Phase2 harness and persisted ledger policy.
nf.Login
nf.WaitFor connected 15
nf.ClassCatalogue
nf.WaitFor class_rpc_error == none 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor own_level == 40 3
nf.Expect world_class == 0
nf.Expect at_class_master
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect transfer_option 1 eligible
nf.Expect options_tier1_tokens == 1
nf.ChangeClass 1
nf.WaitFor class_rpc_error == none 15
nf.WaitFor world_class == 1 3
nf.Expect transfer_granted_skill_keys == 4
nf.Expect transfer_granted_keys l2.skill.1320 l2.skill.1322 l2.skill.194 l2.skill.239
nf.Expect transfer_count == 1
nf.WaitFor own_max_cp > 0 3
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_current_class == 1
nf.Expect options_tier1_tokens == 0
nf.Expect transfer_option 2 eligible
nf.ChangeClass 2
nf.WaitFor class_rpc_error == none 15
nf.WaitFor world_class == 2 3
nf.Expect transfer_granted_skill_keys == 0
nf.Expect transfer_count == 2
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_current_class == 2
nf.Expect options_tier2_tokens == 0
# An irreversible transfer cannot be downgraded to its parent.
nf.ChangeClass 1
nf.WaitFor class_rpc_error == failedprecondition 15
nf.Expect transfer_count == 2
nf.Expect world_class == 2
nf.Character
nf.WaitFor class_rpc_error == none 15
nf.Expect character_class == 2
nf.Expect character_base_class == 0
nf.Expect character_matches_world
nf.DropSocket
nf.WaitFor reconnects >= 1 15
nf.WaitFor own_spawns >= 2 15
nf.WaitFor world_class == 2 3
nf.Expect transfer_granted_skill_keys == 0
nf.Character
nf.WaitFor class_rpc_error == none 15
nf.Expect character_matches_world
nf.TransferOptions
nf.WaitFor class_rpc_error == none 15
nf.Expect options_tier1_tokens == 0
nf.Expect options_tier2_tokens == 0
nf.Within 90
