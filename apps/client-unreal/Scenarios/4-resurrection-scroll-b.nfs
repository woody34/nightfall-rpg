# fixture: phase4-resurrection
# Execution evidence is the live gate run (run-sim-ci.py + phase4-evidence.py), not syntax/traceability.
# Exact inventory/paperdoll/enchant/count source operands: phase4-packs.json.
# Waits: delivery 10ticks*100ms*3=3s (A1); RPC/login policy5s*3=15s.
# Combat fixture allowance30s; death90s; offer180s (inherited phase3 fixtures).
# Source scroll Escape20s*3=60s (pinned DP skills02000-02099; design§8).
# Skill1177 hitTime4000ms*3=12s (pinned DP skills01100-01199.xml:1645).
# Counts/enchant are fixture inputs; numeric formulas are checked by actual-input export oracle.
# item-gate: resurrection_scroll
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor item_baseline 3
nf.Target template:skill_sentinel
nf.WaitFor target != none 3
nf.Attack
nf.WaitFor own_dead 90
nf.WaitFor resurrect_offer_pending 180
nf.Expect resurrect_offer_matches_death
nf.AcceptResurrect latest accept
nf.WaitFor own_hp > 0 3
nf.Expect resurrection_vitals_coherent
# Total budget: sum of declared conservative waits +30s exit grace.
nf.Within 339
