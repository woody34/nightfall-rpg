# covers: 4 E1.4, 4 E1.6, 4 E4.4, 4 E4.5, 4 E4.6, 4 E6.5
# fixture: phase4-kinds
# Pending E2/E3/E5 live integration; syntax/traceability is not execution evidence.
# Exact inventory/paperdoll/enchant/count source operands: phase4-packs.json.
# Waits: delivery 10ticks*100ms*3=3s (A1); RPC/login policy5s*3=15s.
# Combat fixture allowance30s; death90s; offer180s (inherited phase3 fixtures).
# Source scroll Escape20s*3=60s (pinned DP skills02000-02099; design§8).
# Skill1177 hitTime4000ms*3=12s (pinned DP skills01100-01199.xml:1645).
# Counts/enchant are fixture inputs; numeric formulas are checked by actual-input export oracle.
# item-gate: dual_damage
# item-gate: dual_timing
# item-gate: pole_damage
# item-gate: fist_spread
# item-gate: physical_damage
# item-gate: position
# item-gate: blow_success
# item-gate: lethal
# D24 unarmed radius: GAME@abfde049 L2Character.java:5034-5044.
# D25 pole recipients: GAME@abfde049 L2Character.java:1282-1283,1335-1338.
# Blow/lethal (D50): E1 rev 8+ admits Mortal Blow 16 (FatalBlow) and Deadly Blow 263 (FatalBlow +
# Lethal halfLethal10); phase4-packs.json (rev 9) seeds a level-40 Treasure Hunter with ranks
# 16:24 / 263:3 (source skill trees human_fighter→rogue→treasure_hunter). Requires rev 8+ data.
# item-phase: {"name":"blow-mortal","formula":"blow_success","context":{"skill_id":16,"event":"cast"}}
# item-phase: {"name":"blow-deadly","formula":"blow_success","context":{"skill_id":263,"event":"cast"}}
# item-phase: {"name":"lethal-deadly","formula":"lethal","context":{"skill_id":263,"event":"cast"}}
# item-phase: {"name":"dual","formula":"dual_damage","context":{"weapon_template":1299}}
# item-phase: {"name":"dualfist","formula":"dual_damage","context":{"weapon_template":253}}
# item-phase: {"name":"pole-primary","formula":"pole_damage","context":{"weapon_template":15},"inputs":{"primary":true}}
# item-phase: {"name":"pole-secondary","formula":"pole_damage","context":{"weapon_template":15},"inputs":{"primary":false}}
# D84 (rev 9): unarmed resolves the class fists template, so the phase selects on weapon 0 only.
# item-phase: {"name":"unarmed","formula":"fist_spread","context":{"weapon_template":0}}
# Stationary targets retain initial east facing (zone design §6.2, A10).
# item-phase: {"name":"dagger-front","formula":"physical_damage","context":{"weapon_template":10},"inputs":{"caller":"auto","proximity":"front"}}
# item-phase: {"name":"dagger-side","formula":"physical_damage","context":{"weapon_template":10},"inputs":{"caller":"auto","proximity":"side"}}
# item-phase: {"name":"dagger-back","formula":"physical_damage","context":{"weapon_template":10},"inputs":{"caller":"auto","proximity":"back"}}
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor item_baseline 3
nf.Equip 1299
nf.WaitFor equipped rhand == 1299 3
nf.Target template:skill_target
nf.WaitFor target != none 3
nf.Mark
nf.Attack
nf.WaitFor target_hits_since_mark >= 1 30
nf.StopAttack
nf.Equip 253
nf.WaitFor equipped rhand == 253 3
nf.Target template:skill_target
nf.WaitFor target != none 3
nf.Mark
nf.Attack
nf.WaitFor target_hits_since_mark >= 1 30
nf.StopAttack
nf.Equip 15
nf.WaitFor equipped rhand == 15 3
nf.Target template:skill_target
nf.WaitFor target != none 3
nf.Mark
nf.Attack
nf.WaitFor target_hits_since_mark >= 1 30
nf.StopAttack
nf.Equip 10
nf.WaitFor equipped rhand == 10 3
nf.Target template:skill_target
nf.WaitFor target != none 3
# Controlled front position relative to target108,100 facing east.
nf.ClickMove 109 100
nf.WaitFor own_at 109 100 0.1 30
nf.Mark
nf.Attack
nf.WaitFor target_hits_since_mark >= 1 30
nf.StopAttack
# Controlled side position relative to target108,100 facing east.
nf.ClickMove 108 101
nf.WaitFor own_at 108 101 0.1 30
nf.Mark
nf.Attack
nf.WaitFor target_hits_since_mark >= 1 30
nf.StopAttack
# Controlled back position relative to target108,100 facing east.
nf.ClickMove 107 100
nf.WaitFor own_at 107 100 0.1 30
nf.Mark
nf.Attack
nf.WaitFor target_hits_since_mark >= 1 30
nf.StopAttack
# Blow skills from the back position with the dagger (source using kind DAGGER).
nf.Cast 16
nf.WaitFor cast_results >= 1 12
nf.Cast 263
nf.WaitFor cast_results >= 2 12
nf.Unequip rhand
nf.WaitFor equipped rhand == 0 3
nf.Mark
nf.Attack
nf.WaitFor target_hits_since_mark >= 1 30
nf.StopAttack
# Total budget: sum of declared conservative waits +30s exit grace.
nf.Within 414
