# covers: 5 E1.6, 5 E1.8, 5 E2.1, 5 E3.5, 5 E3.15, 5 E5.1, 5 E5.2, 5 E5.6, 5 E5.7, 5 E6.6
# fixture: phase5-party
# Authored by story 1.8 (expectations) for 3.15 (server assertion sections), 5.7 (UI subscope) and 6.6 (live run).
# Execution evidence is the live gate run (run-sim-ci.py + the schema-2 economy export, story 6.2), never this file alone.
# Expected values: the oracle sidecar <this file>.expect.json (phase5-expectations.py over economy_oracle.py); pack inputs:
# fixtures/phase5-packs.json. RNG-dependent outcomes are asserted on received state; exact draws go through econ-gate labels.
# Waits: delivery 10 ticks*100 ms*3 = 3 s; RPC/login policy 5 s*3 = 15 s; combat fixture allowance 30 s; protection 15 s+5.
# Role blocks (`# role: <name>`) select the pack role whose commands follow; a file without a block is role a.
# econ-gate: death_item
# econ-gate: group_chance
# econ-gate: group_select
# econ-gate: party_random
# role: a
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor item_baseline 3
nf.PartyInvite b RANDOM
nf.WaitFor party_member_count == 2 15
nf.PartyInvite c
nf.WaitFor party_member_count == 3 15
nf.Expect loot_mode == RANDOM
nf.Target template:npc_20003
nf.WaitFor target == Npc_20003 3
nf.Attack
nf.WaitFor entity_dead target 30
nf.WaitFor ground_item_exists 57 3
nf.PickUp template:57
nf.WaitFor economy_result == pick_up_item 3
nf.Expect loot_recipient_in_party
# role: b
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor item_baseline 3
nf.WaitFor party_invite_received 15
nf.PartyAnswer 1
nf.WaitFor party_member_count == 2 3
nf.WaitFor party_member_count == 3 15
nf.WaitFor loot_distributed 33
nf.Expect loot_distributed_mode == RANDOM
# role: c
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor item_baseline 3
nf.WaitFor party_invite_received 20
nf.PartyAnswer 1
nf.WaitFor party_member_count == 3 3
nf.Expect own_out_of_party_range
nf.Expect loot_recipient != self
# Total budget: the largest role's sum of declared waits + 30 s exit grace.
nf.Within 132
