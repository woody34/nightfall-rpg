# covers: 1 E2.2, 1a 3.1
# An unknown entity must be rejected without confirming a selection or target HUD.
# Intent processing runs at 10 Hz; three seconds covers thirty ticks.
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.Expect target == none
nf.Target 00000000-0000-0000-0000-000000000001
nf.WaitFor rejected == UNKNOWN_ENTITY 3
nf.Expect target == none
nf.Expect attack_state == idle
nf.Within 45
