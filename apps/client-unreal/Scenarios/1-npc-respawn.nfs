# covers: 1 E3.4, 1 E5.4, 1a 3.2
# 1-kill-one-monster: target the nearest attackable NPC, auto-attack to death, gain XP.
# The plan's §3 example plus the walk: a new character spawns at (0, 0), outside the area of
# interest of the keltir slots (packages/data/zones/test_zone.toml: keltir_a at (100, 100)), so
# it walks there first in moves of at most 64 tiles (the server's MoveTo limit), like a player.
# One floating number per distinct AttackResult; the level is checked against
# packages/data/tables/experience.toml for the XP the kill awarded (keltir.toml xp_reward).
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.ClickMove 40 40
nf.WaitFor own_at 40 40 1 35       # 56.6 tiles at 5 tiles/s (Speed::DEFAULT): 11.3 s, 3x
nf.ClickMove 80 85
nf.WaitFor own_at 80 85 1 35       # 60.2 tiles: 12.0 s, 3x
nf.ClickMove 97 100
nf.WaitFor own_at 97 100 1 15      # 22.7 tiles: 4.5 s, 3x
nf.WaitFor proxies >= 1 3
nf.Target nearest_attackable
nf.WaitFor target != none 3
nf.Attack
nf.WaitFor attack_state == active 3
nf.WaitFor damage_numbers >= 1 10  # first swing lands within one attack interval (~1 s), 3x and the chase
nf.WaitFor target_hp == 0 30       # 44 HP: ~7 swings, measured ~3 s; 3x the 10 s worst case
nf.Expect target == none           # the server clears a dead selection
nf.Expect attack_state == idle
nf.Expect damage_numbers_match_results
nf.WaitFor xp_known 3              # XpGained follows the death in the same tick
nf.WaitFor kill_xp_matches_fixture 3
nf.Expect own_xp > 0
nf.Expect own_level_matches_xp
nf.Expect own_level >= 1
# Leave melee range while retaining the meadow AOI; corpse decay is 10 seconds.
nf.ClickMove 97 80
nf.WaitFor own_at 97 80 1 15
nf.WaitFor last_target_despawned 20
nf.Expect proxy_actors_in_sync
# Fixture respawn delays are 20-40 seconds; 90 seconds gives a >2x margin.
nf.WaitFor last_target_new_life 90
nf.Expect proxy_actors_in_sync
nf.Expect target == none
nf.Within 180
