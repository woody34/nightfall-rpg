# covers: 3 E3.1, 3 E3.5, 3 E4.2, 3 E4.6, 3 E6.7
# fixture: phase3-pvp
# Pending engine/client integration; declaration is not execution evidence.
# Timeouts: received-state delivery 10 ticks *100ms *3 =3s (A1).
# Login/RPC: existing runner allowance5s *3=15s; movement<=37.5tiles /3.75tiles/s *3<=30s.
# Speed input: professions/human_mystic.toml:22 (run120); domain/zone/phase2.rs:109-112 (375milli-tiles/tick).
# Fixture combat30s *3=90s; no damage calculation determines a wait.
# Pinned dp3ca488dd src/main/resources/data/stats/skills/01100-01199.xml:1645,1846:
# Wind Strike base hitTime4000ms *3=12s; Ice Bolt base3100ms *3 rounds up to12s.
# 01000-01099.xml:554,1553,1560: Resurrection6000ms *3=18s, Might1200s *3=3600s.
# A6: regen30ticks *100ms *3=9s; A16/R7: flag1200ticks *100ms *3=360s.
# Boundaries are checked against the estimated current tick (D132) and received deadlines; source waits are conservative budgets.
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor own_sp >= 0 3
nf.Target 01970000-0000-7000-8000-000000000030
nf.WaitFor own_cp_damage_total > 0 30
nf.Expect own_flag == none
nf.Expect cp_absorption_matches_received
nf.WaitFor players_attacking_me == 0 12
nf.WaitFor target_flag == none 360
nf.WaitFor entity_at 01970000-0000-7000-8000-000000000030 110 116 0.5 30
nf.ClickMove 117 116
nf.WaitFor own_at 117 116 0.5 30
nf.WaitFor entity_effect_active 01970000-0000-7000-8000-000000000030 1068 30
nf.ClickMove 115 116
nf.WaitFor own_at 115 116 0.5 6
nf.WaitFor entity_casting 01970000-0000-7000-8000-000000000030 1177 12
nf.ClickMove 117 116
nf.WaitFor own_at 117 116 0.5 6
nf.WaitFor observed_cast_cancel_reason == peace_zone 12
nf.WaitFor peace_impact_has_no_damage 3
# C11/C15: received retention permits regen; replay checks exact HP/CP with the
# independent oracle and rejects any cancelled-cast result or resource damage.
# replay-gate: peace_cancel_no_damage
nf.ClickMove 115 116
nf.WaitFor own_at 115 116 0.5 6
# Purple victim: source rule chooses600ticks; assertion compares received deadlines.
nf.Attack
nf.WaitFor own_flag == pvp 3
nf.StopAttack
nf.Expect own_flag_deadline_matches_received
nf.WaitFor own_dead 90
nf.Expect own_karma == 0
nf.Expect own_pk == 0
nf.Expect own_pvp == 0
nf.Respawn
nf.WaitFor own_hp > 0 3
# Retained flag must naturally expire; no live fixture mutation, no town-protection bypass.
nf.WaitFor own_flag == none 180
nf.ClickMove 115 116
nf.WaitFor own_at 115 116 0.5 30
nf.Target 01970000-0000-7000-8000-000000000030
nf.Attack
nf.WaitFor own_flag == pvp 3
nf.StopAttack
nf.WaitFor own_flag_expired_at_last_impact 360
nf.WaitFor impact_counter_uses_received_flag 3
nf.WaitFor own_dead 90
nf.Expect own_karma == 0
nf.Expect pvp_private_stats_coherent
# Total budget >= sum of the derived per-step timeouts plus30s exit grace.
nf.Within 1500
