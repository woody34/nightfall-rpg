nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor item_baseline 3
nf.ItemCatalog
nf.WaitFor item_catalog_ready 15
nf.Equip 60
nf.WaitFor equipped chest == 60 3
nf.WaitFor equipped legs == 0 3
nf.Expect enchant_level chest == 4
nf.Expect inventory_has 461 == 1
nf.Target template:skill_target
