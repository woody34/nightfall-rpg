# covers: 3 E1.2, 3 E1.6, 3 E3.1, 3 E3.2, 3 E3.3, 3 E3.5, 3 E5.1, 3 E5.4, 3 E5.5, 3 E5.6, 3 E6.7
# fixture: phase3-sp-near-cap
# variant: learn-sp-near-cap
# Pre-admission SP=i64MAX-1 is a boundary input (design v3 §5.1/R13).
# Keltir source reward2 (A17'/R6); expected actual delta1 is a pinned boundary vector.
# A1: state10ticks *100ms *3=3s; login/RPC5s *3=15s; fixture combat30s *3=90s.
nf.Login
nf.WaitFor connected 15
nf.EnterWorld
nf.WaitFor in_world 15
nf.WaitFor own_sp == 9223372036854775806 3
nf.Target template:keltir
nf.WaitFor target != none 3
nf.Attack
nf.WaitFor sp_gained_total == 1 90
nf.StopAttack
nf.Expect own_sp == 9223372036854775807
nf.Expect sp_gained_events == 1
nf.Expect target_hp == 0
nf.DropSocket
nf.WaitFor reconnects >= 1 15
nf.WaitFor in_world 15
nf.Expect own_sp == 9223372036854775807
nf.Expect sp_gained_events == 0
# Sum waits159s plus30s exit grace.
nf.Within 189
