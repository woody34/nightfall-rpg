# Unreal build products and local state. Project-owned Content may be versioned; vendor assets are excluded below.
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
# Third-party downloads and imported/derived vendor assets (matches Vendor/ and Content/Vendor/).
# LFS does not grant permission to redistribute licensed assets.
Vendor/
.vs/
.vscode/
.idea/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace
*.code-workspace
# Generated protobuf code is produced by Scripts/gen-proto.sh; commit it so the editor builds without protoc.
!Source/Nightfall/Generated/
# Version the project's Gauntlet source, not generated build products.
!Build/
Build/*
!Build/Scripts/
Build/Scripts/*
!Build/Scripts/*.cs
!Build/Scripts/*.csproj

Scripts/__pycache__/
